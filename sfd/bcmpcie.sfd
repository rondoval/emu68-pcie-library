* OBSOLETE: use AllocIntVectors() with PCI_IRQ_MSI.  Retained for compatibility;
* selects single-vector MSI or INTx only and never MSI-X.
* Returns PCIE_OK, or PCIE_ERR_INVAL (bad dev) / PCIE_ERR_NODEV (no MSI cap).
* See <libraries/bcmpcie_errors.h>.
LONG EnableMSI(struct pci_dev *dev) (A0)
void DisableMSI(struct pci_dev *dev) (A0)
* Returns PCIE_OK, or PCIE_ERR_INVAL (bad dev) / PCIE_ERR_NOTSUPP (FLR not supported).
LONG FLR(struct pci_dev *dev) (A0)
* -288: Extended config space access (ULONG register argument; supports offsets >= 0x100)
UBYTE ReadExtConfigByte(ULONG reg, struct pci_dev *dev) (D0,A0)
UWORD ReadExtConfigWord(ULONG reg, struct pci_dev *dev) (D0,A0)
ULONG ReadExtConfigLong(ULONG reg, struct pci_dev *dev) (D0,A0)
void WriteExtConfigByte(ULONG reg, UBYTE val, struct pci_dev *dev) (D0,D1,A0)
void WriteExtConfigWord(ULONG reg, UWORD val, struct pci_dev *dev) (D0,D1,A0)
void WriteExtConfigLong(ULONG reg, ULONG val, struct pci_dev *dev) (D0,D1,A0)
* -324: Interrupt masking
* These functions do NOT acquire the library semaphore.  With MSI or MSI-X
* active they are safe to call from interrupt context (e.g. from within an
* installed interrupt server); with INTx they access config space and must be
* called from task context.
* OBSOLETE: MaskMSI/UnmaskMSI -> use MaskIntVector/UnmaskIntVector.
* OBSOLETE: CheckSetINTxMask -> use MaskIntVector/UnmaskIntVector.  Since 2.5 the
* INTx mask is unconditional (lines are exclusive) and the call returns TRUE.
void MaskMSI(struct pci_dev *dev) (A0)
void UnmaskMSI(struct pci_dev *dev) (A0)
BOOL CheckSetINTxMask(struct pci_dev *dev, BOOL mask) (A0,D0)
* -342: Typed, multi-vector interrupt API (preferred over EnableMSI/pci_add_intserver).
* flags is a mask of PCI_IRQ_INTX | PCI_IRQ_MSI | PCI_IRQ_MSIX (see pci_constants.h);
* AllocIntVectors picks the best allowed type MSI-X -> MSI -> INTx and returns the
* number of vectors reserved.  AddIntVectorServer/RemIntVectorServer attach and detach
* a vector's interrupt server (one per vector; RemIntVectorServer ignores an isr that
* is not the vector's); FreeIntVectors releases the vectors and first detaches any
* server still attached; GetIntVectorType returns the active PCI_IRQ_* type (0 if none).
* MaskIntVector/UnmaskIntVector return TRUE, or FALSE for a bad vector index.
* MSI and MSI-X are masked at the root complex (the vector's MSI demux slot, a
* local register write, no PCIe transaction, ISR-safe); a message that arrives
* while masked latches and fires on unmask.  INTx sets/clears the PCI command
* register's INTX_DISABLE bit unconditionally - INTx lines are exclusive in this
* stack (gic400 takes one server per line), so there is no pending state to
* guard - and, being a config-space access, must be called from task context.
* AllocIntVectors returns the vector count (>= min) on success, or a negative
* PCIE_ERR_* code: PCIE_ERR_INVAL (bad dev or range), PCIE_ERR_BUSY (vectors already
* allocated), PCIE_ERR_NODEV (no usable type), PCIE_ERR_NOMEM (out of vectors).
* AddIntVectorServer returns PCIE_OK or PCIE_ERR_INVAL (bad dev, isr or vector) /
* PCIE_ERR_BUSY (the vector, or the INTx line, already has a server) / PCIE_ERR_IO.
* Codes are defined in <libraries/bcmpcie_errors.h>.
LONG AllocIntVectors(struct pci_dev *dev, ULONG min, ULONG max, ULONG flags) (A0,D0,D1,D2)
void FreeIntVectors(struct pci_dev *dev) (A0)
LONG AddIntVectorServer(struct pci_dev *dev, ULONG vec, struct Interrupt *isr) (A0,D0,A1)
void RemIntVectorServer(struct pci_dev *dev, ULONG vec, struct Interrupt *isr) (A0,D0,A1)
BOOL MaskIntVector(struct pci_dev *dev, ULONG vec) (A0,D0)
BOOL UnmaskIntVector(struct pci_dev *dev, ULONG vec) (A0,D0)
ULONG GetIntVectorType(struct pci_dev *dev) (A0)
==end
